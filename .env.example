# Full published-to-web CSV URL of the Words sheet.
# Obtained from: File -> Publish to web -> sheet: Words -> Comma-separated values (.csv)
# Copy it verbatim. It cannot be derived from the spreadsheet id.
SHEET_CSV_URL=

# Normal (editable) sheet URL, used for the "edit in the sheet" link in the UI.
NEXT_PUBLIC_SHEET_EDIT_URL=

# How many previously unseen cards enter the queue per day
NEXT_PUBLIC_NEW_PER_DAY=10

# Optional shared access key for a deployed instance. When set, every page and the words
# API ask for it once per device (entered at /gate). Leave empty to keep the app open —
# development and both test suites run without it.
APP_KEY=
